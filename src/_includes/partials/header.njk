<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-header__brand" href="{{ '/' | url }}">{{ site.name }}</a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="primary-nav">
      <span class="sr-only">Menu</span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
    </button>
    <nav id="primary-nav" class="site-nav">
      <ul>
        {% for item in site.nav %}
        <li><a href="{{ item.href | url }}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endfor %}
        <li><a class="btn btn--nav" href="{{ site.cta.href | url }}">{{ site.cta.label }}</a></li>
      </ul>
    </nav>
  </div>
</header>
