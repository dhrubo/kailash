---
layout: layouts/base.njk
title: Contact Us
description: Get in touch with Kailash at our registered office in Kolkata, or reach the Secretary, Sri Arpan Banerjee, by phone or email.
permalink: /contact-us/
---
<section class="page-intro">
  <div class="wrap">
    <h1>Contact Us</h1>
  </div>
</section>

<article class="wrap page-content">

  <section>
    <div class="contact-card">
      <h2>Kailash</h2>
      <dl>
        <dt>Secretary</dt>
        <dd>
          {{ site.contact.secretary }} —
          <!-- TODO confirm phone number with client, see site.json contact.phoneNoteForDev -->
          <a href="tel:+919007527678">+91 9007527678</a>
        </dd>

        <dt>Registered Office</dt>
        <dd>{{ site.contact.registeredOffice }}</dd>

        <dt>Mobile</dt>
        <dd><a href="tel:{{ site.contact.phones[1].tel }}">+91 {{ site.contact.phones[1].display }}</a></dd>

        <dt>Email</dt>
        <dd><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></dd>

        <dt>Registration Number</dt>
        <dd>{{ site.contact.regNo }}</dd>

        <dt>CSR Registration Number</dt>
        <dd>{{ site.contact.csrRegNo }}</dd>
      </dl>
      <p>{{ site.contact.taxNote }}</p>
    </div>
  </section>

  <section>
    <h2>Contact Form</h2>
    <p>Our online enquiry form isn't wired up yet — until then, please write to us directly:</p>
    <p>Contact us at <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a> or call <a href="tel:{{ site.contact.phones[0].tel }}">{{ site.contact.phones[0].display }}</a>.</p>

    <!-- Static preview of the original Contact Form 7 fields; no backend/reCAPTCHA wired up yet. -->
    <form class="contact-form-static" aria-disabled="true">
      <div>
        <label for="first-name">First Name *</label>
        <input type="text" id="first-name" name="first-name" disabled>
      </div>
      <div>
        <label for="last-name">Last Name *</label>
        <input type="text" id="last-name" name="last-name" disabled>
      </div>
      <div>
        <label for="your-email">Email *</label>
        <input type="email" id="your-email" name="your-email" disabled>
      </div>
      <div>
        <label for="your-phone">Mobile *</label>
        <input type="tel" id="your-phone" name="your-phone" disabled>
      </div>
      <div>
        <label for="your-message">Comment</label>
        <textarea id="your-message" name="your-message" rows="4" disabled></textarea>
      </div>
      <button type="button" class="btn" disabled>Submit</button>
    </form>
  </section>

</article>
