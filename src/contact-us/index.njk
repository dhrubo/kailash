---
layout: layouts/base.njk
title: Contact Us
description: Get in touch with Kailash at our registered office in Kolkata, or reach the Secretary, Sri Arpan Banerjee, by phone or email.
permalink: /contact-us/
---
<section class="page-intro">
  <div class="wrap">
    <h1>Contact Us</h1>
  </div>
</section>

<article class="wrap page-content">

  <section>
    <div class="contact-card">
      <h2>Kailash</h2>
      <dl>
        <dt>Secretary</dt>
        <dd>
          {{ site.contact.secretary }} —
          <!-- TODO confirm phone number with client, see site.json contact.phoneNoteForDev -->
          <a href="tel:+919007527678">+91 9007527678</a>
        </dd>

        <dt>Registered Office</dt>
        <dd>{{ site.contact.registeredOffice }}</dd>

        <dt>Mobile</dt>
        <dd><a href="tel:{{ site.contact.phones[1].tel }}">+91 {{ site.contact.phones[1].display }}</a></dd>

        <dt>Email</dt>
        <dd><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></dd>

        <dt>Registration Number</dt>
        <dd>{{ site.contact.regNo }}</dd>

        <dt>CSR Registration Number</dt>
        <dd>{{ site.contact.csrRegNo }}</dd>
      </dl>
      <p>{{ site.contact.taxNote }}</p>
    </div>
  </section>

  <section>
    <h2>Contact Form</h2>
    <p>Prefer to write directly? Contact us at <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a> or call <a href="tel:{{ site.contact.phones[0].tel }}">{{ site.contact.phones[0].display }}</a>.</p>

    <!--
      Submits via Formspree (a free-tier form backend for static sites — no server needed).
      Set up: create a form at https://formspree.io, verify the recipient email, then paste
      the endpoint it gives you into src/_data/site.json -> formEndpoints.contact.
      Until that's done, submissions will fail with a 404 from Formspree.
    -->
    <form class="contact-form-static" action="{{ site.formEndpoints.contact }}" method="POST">
      <div>
        <label for="first-name">First Name *</label>
        <input type="text" id="first-name" name="first-name" required>
      </div>
      <div>
        <label for="last-name">Last Name *</label>
        <input type="text" id="last-name" name="last-name" required>
      </div>
      <div>
        <label for="your-email">Email *</label>
        <input type="email" id="your-email" name="email" required>
      </div>
      <div>
        <label for="your-phone">Mobile *</label>
        <input type="tel" id="your-phone" name="mobile" required>
      </div>
      <div>
        <label for="your-message">Comment</label>
        <textarea id="your-message" name="message" rows="4"></textarea>
      </div>
      <input type="hidden" name="_subject" value="New enquiry from kailash-shivanandam.com contact form">
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off">
      <input type="hidden" name="_next" value="{{ '/thank-you/' | url }}">
      <button type="submit" class="btn">Submit</button>
    </form>
  </section>

</article>
